{
  "name": "endurance-coach",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run e2e",
    "serve:test": "node scripts/test-server.mjs 4180",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  }
}
